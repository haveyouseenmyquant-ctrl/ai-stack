{
  "version": 1,
  "defaults": {
    "coldDays": 60,
    "minCompressionGain": 0.25,
    "minCompressBytes": 262144,
    "neverModifiedWithinDays": 7,
    "undecidedExpiryDays": 30,
    "installerAgeDays": 30,
    "inactiveProjectDays": 90,
    "duplicateMinBytes": 102400,
    "busyCpuPercent": 20
  },
  "categories": [
    { "id": "cold-compressible", "action": "compress", "tier": 1,
      "label": "Compress {count} cold files in place (they still open normally)",
      "match": { "kind": "coldCompressible" },
      "paths": { "macos": ["~"], "windows": ["%USERPROFILE%"] } },
    { "id": "opted-in-archive", "action": "archiveFolder", "tier": 1,
      "label": "Zip {count} folders you marked for archiving",
      "match": { "kind": "optedInFolders" },
      "paths": { "macos": [], "windows": [] } },
    { "id": "malware", "action": "quarantine", "tier": 1,
      "label": "Quarantine {count} files ClamAV flags as malware (undo restores them)",
      "match": { "kind": "clamav" },
      "paths": { "macos": ["~/Downloads", "~/Desktop"], "windows": [] } },
    { "id": "cache", "action": "moveToTrash", "tier": 2, "ruleable": true,
      "label": "Delete {count} app caches (apps rebuild them)",
      "match": { "kind": "children" },
      "paths": { "macos": ["~/Library/Caches"], "windows": ["%LOCALAPPDATA%"] } },
    { "id": "downloads-installer", "action": "moveToTrash", "tier": 2, "ruleable": true,
      "label": "Delete {count} installers in Downloads older than {installerAgeDays} days",
      "match": { "kind": "extensions", "extensions": [".dmg", ".pkg", ".zip", ".msi", ".exe", ".iso"], "olderThanDays": "installerAgeDays" },
      "paths": { "macos": ["~/Downloads"], "windows": ["%USERPROFILE%\\Downloads"] } },
    { "id": "duplicate", "action": "moveToTrash", "tier": 2, "ruleable": true,
      "label": "Delete {count} duplicate files (an identical copy is kept)",
      "match": { "kind": "duplicates" },
      "paths": { "macos": ["~/Documents", "~/Desktop", "~/Downloads"], "windows": ["%USERPROFILE%\\Documents", "%USERPROFILE%\\Desktop", "%USERPROFILE%\\Downloads"] } },
    { "id": "node-modules", "action": "moveToTrash", "tier": 2, "ruleable": true,
      "label": "Delete node_modules in {count} projects untouched for {inactiveProjectDays} days",
      "match": { "kind": "namedDirs", "name": "node_modules", "olderThanDays": "inactiveProjectDays" },
      "paths": { "macos": ["~/Code", "~/Projects", "~/Developer", "~/Documents"], "windows": ["%USERPROFILE%\\Code", "%USERPROFILE%\\Projects", "%USERPROFILE%\\source"] } },
    { "id": "xcode-derived-data", "action": "moveToTrash", "tier": 2, "ruleable": true,
      "label": "Delete Xcode build data for {count} projects",
      "match": { "kind": "children" },
      "paths": { "macos": ["~/Library/Developer/Xcode/DerivedData"], "windows": [] } },
    { "id": "trash", "action": "emptyTrash", "tier": 2,
      "label": "Empty the Trash",
      "match": { "kind": "self" },
      "paths": { "macos": ["~/.Trash"], "windows": [] } },
    { "id": "persistence", "action": "disableStartupItem", "tier": 2, "ruleable": true,
      "label": "Disable {count} suspicious startup items",
      "match": { "kind": "startupItems" },
      "paths": { "macos": ["~/Library/LaunchAgents"], "windows": [] } },
    { "id": "busy-process", "action": "quitProcess", "tier": 2,
      "label": "Quit {count} processes using a lot of CPU",
      "match": { "kind": "busyProcesses" },
      "paths": { "macos": [], "windows": [] } }
  ],
  "neverPaths": {
    "macos": ["~/Library/Keychains", "~/Library/Mail", "~/Library/Messages", "~/Library/Safari",
              "~/Library/Application Support/Google/Chrome", "~/Library/Application Support/Firefox",
              "~/Library/Application Support/BraveSoftware", "~/Library/Application Support/Microsoft Edge",
              "~/Library/Application Support/Arc", "~/Library/Group Containers/2BUA8C4S2C.com.1password",
              "~/Library/Application Support/Bitwarden", "~/Library/Application Support/AIStack/Doctor"],
    "windows": ["%APPDATA%\\Microsoft\\Credentials", "%LOCALAPPDATA%\\Microsoft\\Credentials",
                "%APPDATA%\\Microsoft\\Protect", "%LOCALAPPDATA%\\Google\\Chrome\\User Data",
                "%LOCALAPPDATA%\\Microsoft\\Edge\\User Data", "%APPDATA%\\Mozilla\\Firefox",
                "%LOCALAPPDATA%\\Microsoft\\Outlook", "%LOCALAPPDATA%\\AIStack\\doctor"]
  },
  "neverNameSuffixes": [".photoslibrary", ".keychain", ".keychain-db", ".pst", ".ost"],
  "incompressibleExtensions": [".jpg", ".jpeg", ".png", ".heic", ".gif", ".webp", ".mp4", ".mov", ".m4v", ".mkv", ".mp3",
    ".m4a", ".aac", ".zip", ".gz", ".tgz", ".bz2", ".xz", ".7z", ".rar", ".zst", ".dmg", ".pkg", ".pdf", ".docx",
    ".xlsx", ".pptx", ".jar", ".apk", ".ipa", ".iso"]
}
